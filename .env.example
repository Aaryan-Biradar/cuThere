# ---------------------------------------------------------------------------
# cuThere — example environment variables
# Copy this file to .env and fill in your values (this is the ONLY env file;
# there is no .env.local).
# All NEXT_PUBLIC_* vars are inlined at build time and exposed to the browser.
# ---------------------------------------------------------------------------

# ── Database (Turso / libSQL) ──────────────────────────────────────────────
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ── Scraper pipeline (node src/lib/pipeline/main.js) ───────────────────────
# Google Gemini key used to classify posts and extract event details.
GEMINI_API_KEY=
# Optional: override the Gemini model. Default: gemini-2.5-flash
# GEMINI_MODEL=
# Vercel Blob token — event flyer image storage.
BLOB_READ_WRITE_TOKEN=
# Apify token(s) for Instagram scraping. Add APIFY_API_TOKEN_2, _3, … to
# rotate keys; the scraper picks them up automatically in numeric order.
APIFY_API_TOKEN_1=

# ── Web app (server) ───────────────────────────────────────────────────────
# Optional: Discord webhook that receives feedback-form submissions.
DISCORD_WEBHOOK_URL=

# ── Web app (browser, NEXT_PUBLIC_*) ───────────────────────────────────────
# Amplitude analytics API key.
NEXT_PUBLIC_AMPLITUDE_API_KEY=

# Comma-separated list of tags pinned to the front of the filter pill row
# (right after "This Week"). Every other tag is ordered by upcoming-event count.
# Default: Free Food
NEXT_PUBLIC_PINNED_TAGS=Free Food

# Number of days ahead that the "This Week" section spans.
# Default: 7
NEXT_PUBLIC_THIS_WEEK_DAYS=7

# IANA timezone string used for calendar event times on the event detail page.
# Default: America/Toronto
NEXT_PUBLIC_TIMEZONE=America/Toronto

# Optional: footer LinkedIn links for the two builders.
# Default: https://www.linkedin.com/
# NEXT_PUBLIC_LINKEDIN_URL_1=
# NEXT_PUBLIC_LINKEDIN_URL_2=
